{
  "name": "dsh-vision",
  "version": "0.1.0",
  "description": "DSH 视觉系统：analyze_image 识图工具（智谱 GLM-4.6V-Flash 免费，限流自动降级）+ screenshot 截图工具 + 粘贴/拖拽/按钮三入口；内置压缩、结果缓存、OCR 模式、多图批量、区域裁切。",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./lib/client.bundle.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --check src/index.mjs && node --check lib/client.bundle.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "vision",
    "识图",
    "视觉"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
