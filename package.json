{
  "name": "dsh-workspace-frontend",
  "version": "0.1.1",
  "type": "module",
  "description": "DSH 重修整合包：根目录是工作区美化插件本体，pack/ 子目录是整套环境安装器（任务列表 / 编码 / LSP / 视觉 / 白皮书）。",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zcc50/dsh-rebuild.git"
  },
  "homepage": "https://github.com/Zcc50/dsh-rebuild",
  "bugs": { "url": "https://github.com/Zcc50/dsh-rebuild/issues" },
  "keywords": ["deepseek-harness", "dsh-plugin", "session-groups", "sidebar", "workspace", "rebuild"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}